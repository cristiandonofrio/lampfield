{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lampfield",
  "version": "0.1.0",
  "identifier": "dev.cristiandonofrio.lampfield",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Lampfield", "width": 900, "height": 640, "minWidth": 380, "minHeight": 300 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
